# Copy this file to ".env.local" and fill in your Supabase project values.
# The anon key is PUBLIC and safe to ship in the frontend bundle — it only grants
# whatever your Row-Level Security policies allow (public reads, admin-only writes).
#
# Leave these blank and the site still runs: the live timer falls back to a plain
# countdown and the /admin panel + Round 2 gate show a "not configured" state.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
